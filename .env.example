# คัดลอกเป็น .env แล้วกรอกค่า — .env ถูก gitignore ไว้ อย่า commit
#
# โหลดเข้า environment ก่อนเรียก claude หรือ wrangler:
#   set -a; . ./.env; set +a

# bearer token ของ /mcp — ค่าเดียวกับ secret บน Worker
# .mcp.json อ่านค่านี้ผ่าน ${MCP_AUTH_TOKEN}
MCP_AUTH_TOKEN=""

# ชี้ไป Worker ตัวอื่นได้ เช่นตัว staging ถ้าไม่ตั้งจะใช้ค่า default ใน .mcp.json
# ODOO_MCP_URL="https://cf-odoo-mcp-server-staging.<subdomain>.workers.dev/mcp"

# ใช้ตอน deploy เท่านั้น ไม่เกี่ยวกับการต่อ client
# CLOUDFLARE_API_TOKEN=""
